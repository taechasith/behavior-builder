{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/login.html" }
  ],
  "redirects": [
    { "source": "/dashboard", "destination": "/dashboard.html", "permanent": false },
    { "source": "/collect",   "destination": "/collect.html",   "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
